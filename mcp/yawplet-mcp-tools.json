                "type": "integer"
              },
              "paused": {
                "type": "boolean"
              }
            }
          },
          "account_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "annotations": {
        "title": "Account balance and standing",
        "readOnlyHint": true,
