      {
        "name": "present_attestation",
        "title": "Present a Know Your Agent attestation",
        "description": "Show Yawplet who you are. Get an attestation from apis.io (POST https://apis.io/api/v1/kya/attest with aud=https://yawplet.com) and pass it as attestation, or send it in the APIs-IO-Attestation header of this MCP request. A key-bound attestation counts only if this MCP request is Web Bot Auth-signed with the bound key. The decision (trusted or known) is stored on the account; trusted raises the free search allowance and never changes prices or the owner's card requirement.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "attestation": {
              "type": "string",
              "description": "The kya+jwt, when a header is not convenient (the MCP tool and A2A skill send it this way)."
            }
          }
        },
        "outputSchema": {
          "type": "object",
          "description": "What this site decided about the agent behind the account, from an apis.io Know Your Agent attestation.",
          "properties": {
            "decision": {
              "type": "string",
              "enum": [
                "trusted",
                "known",
                "none"
              ]
            },
            "sub": {
              "type": "string",
              "description": "The KYA subject, e.g. wba:<domain>."
            },
            "issuer": {
              "type": "string"
            },
            "tier": {
              "type": "string",
              "enum": [
                "anonymous",
                "named",
                "confirmed",
                "anchored"
              ]
            },
            "bound": {
              "type": "boolean",
              "description": "The request was signed with the key the attestation is bound to."
            },
            "agent": {
              "type": [
                "string",
                "null"
              ],
              "description": "The agent registry slug on apis.io."
            },
            "registry": {
              "type": [
                "string",
                "null"
              ]
            },
            "record": {
              "type": [
                "string",
                "null"
              ],
              "description": "The public KYA record."
            },
            "disclosure": {
              "type": [
                "number",
                "null"
              ]
            },
            "verification": {
              "type": [
                "number",
                "null"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "unlocks": {
              "type": "object"
            },
            "how": {
              "type": "string"
            }
          }
        },
        "annotations": {
          "title": "Present a Know Your Agent attestation",
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
        },
        "_meta": {
          "operationId": "presentAttestation"
        }
